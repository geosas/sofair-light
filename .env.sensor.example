# Credentials of the HTTPS-connected sensors (read by app/config_sensor.py).
#
# Copy this file to `.env.sensor` (repository root) and fill in the values.
# `.env.sensor` is gitignored.
#
# Non-LoRaWAN sensors push their files to POST /sensors/<driver>/<param>. They
# cannot carry the application's cookie JWT, so each driver authenticates them
# itself (OTT uses HTTP Basic) against the values below.

# --- OTT probe --------------------------------------------------------------
# The application REFUSES TO START while the password keeps its default value:
# 'change-me' is published in app/config_sensor.py, so anyone could push forged
# observations to the endpoint.
export SENSOR_OTT_USER=ott
export SENSOR_OTT_PASSWORD=
