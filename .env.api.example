# Environment variables read by the API at startup.
#
# Copy this file to `.env.api` (repository root) and fill in the values.
# `.env.api` is gitignored.
#
# `run.py` loads it with os.environ.setdefault(), so a variable already present
# in the real environment always wins. In production prefer defining these
# through systemd / Apache rather than this file.
#
#

# --- Database (least-privilege role, NEVER the Postgres superuser) ----------
# The API talks straight to the FROST databases for the proxy's CSV / dataArray
# / covjson routes. The role must own OBSERVATIONS and be NOSUPERUSER.
# frost/create_db.sh writes this whole block for you.
export STALT_DB_USER=sofair_api
export STALT_DB_PASSWORD=
export STALT_DB_HOST=localhost
export STALT_DB_PORT=5433

# --- Signing secrets --------------------------------------------------------
# The application refuses to start while these keep their default value.
# Generate each one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
export SECRET_KEY=
export JWT_SECRET_KEY=

# Shared secret expected in the `LoRaWAN-Request` header of the network
# server's uplinks on POST /sensors/post-lorawan/. Not a random key: the same
# value must be configured on the LoRaWAN network server.
export STALT_LORAWAN_SECRET=

# --- ORCID SSO (optional) ---------------------------------------------------
# Without CLIENT_ID/CLIENT_SECRET the provider is not registered and
# /auth/orcid/* returns 404 (local authentication only).
# export ORCID_CLIENT_ID=
# export ORCID_CLIENT_SECRET=
# export ORCID_BASE_URL=https://sandbox.orcid.org
# export AUTH_MODE=both

# --- Miscellaneous ----------------------------------------------------------
# Repository advertised in the page footer. Point it at YOUR fork if you deploy
# a modified version.
# export SOURCE_URL=https://github.com/geosas/sofair-light

# Set to 1 to downgrade the startup guard above to a warning.
# LOCAL DEVELOPMENT ONLY - never in production.
# export STALT_ALLOW_INSECURE_DEFAULTS=1
